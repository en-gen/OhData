{
  "stryker-config": {
    "project": "OhData.Client.csproj",
    "solution": "src/OhData.sln",
    "target-framework": "net10.0",
    "test-projects": ["src/OhData.Client.Tests/OhData.Client.Tests.csproj"],
    "coverage-analysis": "perTest",
