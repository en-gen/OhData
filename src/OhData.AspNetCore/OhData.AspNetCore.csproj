<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<PackageId>EnGen.OhData.AspNetCore</PackageId>
		<Title>OhData for ASP.NET Core</Title>
		<Description>Convention-based OData 4.0 server for ASP.NET Core minimal APIs. Turn declarative profile classes into registered OData endpoints at startup — no controllers required.</Description>
		<Copyright>Copyright (c) en-gen and contributors</Copyright>
		<PackageTags>odata;odata4;aspnetcore;minimal-api;rest;api;edm;csdl;entityset</PackageTags>
		<!-- AD0001: RouteHandlerAnalyzer NullReferenceException — pre-existing analyzer bug, not our code -->
		<NoWarn>$(NoWarn);AD0001</NoWarn>
		<!--
		  Package validation: catches breaking API/ABI changes and TFM-compat
		  issues before they ship. Every pack is diffed against the published
		  baseline below; bump the baseline as part of each release.

		  #581 / 2.0.0: the eight handler delegates on EntitySetProfile<TKey,TModel> change shape,
		  which is an INTENTIONAL break and the reason this release is a major. ApiCompat can only
		  baseline against a PUBLISHED version, so there is no 2.x package to diff against until
		  2.0.0 ships — leaving the 1.7.0 baseline in place reports those eight breaks on every
		  build, forever.

		  The two ways out are a suppression file or suspending the baseline. This repo has never
		  had a suppression file and does not want its first one to be a permanent record of a break
		  that is deliberate and already documented, so the baseline is suspended for the 2.0.0
		  cycle. EnablePackageValidation stays TRUE: the TFM-compat and same-version checks still
		  run; only the cross-version diff is off.

		  RESTORE AT CLOSE-OUT, pointing at 2.0.0 — docs/releasing.md carries the step.
		-->
		<EnablePackageValidation>true</EnablePackageValidation>
		<!-- <PackageValidationBaselineVersion>1.7.0</PackageValidationBaselineVersion> -->
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OData" Version="[9.5.*, 10)" />
		<PackageReference Include="Microsoft.OData.ModelBuilder" Version="[2.*, 3)" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="OhData.AspNetCore.Tests" />
		<!--
		  #228: the OpenAPI companion packages read the internal per-profile
		  IgnoredPropertyNames (via IgnoredPropertyDocsMap) so generated schemas
		  omit Ignore()d properties, matching the real wire shape.
		-->
		<!--
		  #665: delta mapping moved to the mapper package, which needs the registration
		  seams the core kept private for it: OhDataBuilder.Services, ProfileScanner's
		  kind predicate, and the IOhDataStartupValidated marker MapOhData resolves.
		-->
		<InternalsVisibleTo Include="OhData.AspNetCore.Mapper" />
		<InternalsVisibleTo Include="OhData.AspNetCore.OpenApi" />
		<InternalsVisibleTo Include="OhData.AspNetCore.NSwag" />
		<InternalsVisibleTo Include="OhData.AspNetCore.Swashbuckle" />
		<!--
		  #389: OpenTypeKeyValidationBenchmarks measures the open-type serialize path, which is
		  reachable only through internals — OpenTypeJsonOptions, its Build/BuildOpenComplexTypeContainerMap
		  entry points and IsValidDynamicPropertyNameCached are all internal. The public alternative is
		  an end-to-end HTTP request, which measures the whole pipeline and cannot isolate a per-key
		  cost. This grant exists so the benchmark measures the SHIPPED validator rather than a copy of
		  it — a copy is exactly the mistake that produced a 12x-wrong number for this code path once
		  already. It widens no public API and changes no behaviour; it does add one row to the shipped
		  assembly's metadata, so if the measurement is finished with, it can be reverted.
		-->
		<InternalsVisibleTo Include="OhData.Server.Benchmarks" />
	</ItemGroup>

</Project>
